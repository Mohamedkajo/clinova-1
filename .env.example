BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_RETENTION=14
BACKUP_TIME=02:00
BACKUP_RUN_ON_START=false
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf
LOG_DIR=./logs
WHATSAPP_ENABLED=false
WHATSAPP_DRY_RUN=false
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
