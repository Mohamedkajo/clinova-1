PORT=3000
HOST=127.0.0.1
APP_URL=https://clinova.example.com
DATABASE_URL=postgres://clinova_user:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/clinova
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CONNECTION_TIMEOUT_MS=10000
WORKER_POLL_INTERVAL_MS=5000
WORKER_STALE_AFTER_MS=120000
WORKER_RETRY_BASE_MS=5000
SESSION_SECRET=replace-with-a-long-random-secret-at-least-48-chars
COOKIE_SECURE=true
TRUSTED_PROXY_IPS=127.0.0.1,::1
CORS_ALLOWED_ORIGINS=https://clinova.example.com
BACKUP_ENABLED=true
BACKUP_DIR=/var/backups/clinova
BACKUP_RETENTION=30
BACKUP_TIME=02:00
BACKUP_RUN_ON_START=false
UPLOAD_DIR=/var/lib/clinova/uploads
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf
LOG_DIR=/var/log/clinova
HEALTHCHECK_URL=http://127.0.0.1:3000/api/health
PM2_MONITOR_EXPECTED_PROCESSES=clinova,clinova-worker,clinova-backup
DISK_MONITOR_PATHS_JSON=[{"label":"uploads","path":"/var/lib/clinova/uploads"},{"label":"backups","path":"/var/backups/clinova"},{"label":"logs","path":"/var/log/clinova"}]
WHATSAPP_ENABLED=false
WHATSAPP_DRY_RUN=false
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=972
